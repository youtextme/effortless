{
  "platformVersion": "1.0.0",
  "kernel": {
    "id": "kernel",
    "version": "1.0.0",
    "modules": ["registry", "bus", "health", "telemetry", "policy", "context", "capabilities"]
  },
  "components": [
    {
      "id": "storage",
      "version": "1.1.0",
      "dependencies": [],
      "description": "Progress persistence via localStorage adapter, including resume memory",
      "events": { "emits": ["progress.loaded", "progress.saved", "passage.completed"], "listens": [] }
    },
    {
      "id": "passage",
      "version": "1.0.0",
      "dependencies": [],
      "description": "Topic passage generation and vocabulary highlighting",
      "events": { "emits": ["passage.generated"], "listens": [] }
    },
    {
      "id": "reading",
      "version": "1.0.0",
      "dependencies": ["passage", "storage"],
      "description": "Reading surface, scroll unlock, FAB",
      "events": { "emits": ["reading.loaded", "reading.scrolled-to-end"], "listens": ["passage.generated"] }
    },
    {
      "id": "speech",
      "version": "2.0.0",
      "dependencies": [],
      "description": "Visible-text speech engine, warm-mother voice picker, global Listen control",
      "events": { "emits": ["tts.unavailable", "tts.spoken"], "listens": [] }
    },
    {
      "id": "tts",
      "version": "2.0.0",
      "dependencies": ["speech"],
      "description": "Legacy TTS adapter — delegates to speech",
      "events": { "emits": [], "listens": [] }
    },
    {
      "id": "word-sheet",
      "version": "1.0.0",
      "dependencies": ["speech", "tts"],
      "description": "Word tap sheet with pronunciation and examples",
      "events": { "emits": ["word.opened", "word.closed"], "listens": [] }
    },
    {
      "id": "quiz",
      "version": "2.0.0",
      "dependencies": ["storage"],
      "description": "Kid-think takeaway quiz with coaching, no pass wall",
      "events": { "emits": ["quiz.started", "quiz.answered", "quiz.completed", "quiz.failed"], "listens": ["reading.scrolled-to-end"] }
    },
    {
      "id": "certificate",
      "version": "1.0.0",
      "dependencies": ["storage"],
      "description": "Minimal printable certificate and share",
      "events": { "emits": ["certificate.generated", "certificate.shared"], "listens": ["quiz.completed"] }
    },
    {
      "id": "capability",
      "version": "1.0.0",
      "dependencies": ["storage"],
      "description": "Registry of reusable learning catalogs (passages, words, later math/diagrams)",
      "events": { "emits": ["capability.unhandled", "capability.failed"], "listens": [] }
    },
    {
      "id": "home",
      "version": "1.2.0",
      "dependencies": ["storage", "capability"],
      "description": "Home catalogs (words, passages) and settings (name, speech, PWA install)",
      "events": { "emits": ["home.opened", "home.tab"], "listens": [] }
    },
    {
      "id": "shell",
      "version": "1.2.0",
      "dependencies": ["storage", "reading", "word-sheet", "quiz", "certificate", "speech", "tts", "home", "capability"],
      "description": "App composition root and screen orchestration",
      "events": { "emits": ["app.ready", "app.error"], "listens": [] }
    }
  ]
}
